.vscode/
.vs/
.qtcreator/

quicktest/

# Vision training products are prepared outside the source tree. These guards
# prevent accidental commits if a developer points a script at the repository.
third_party/tinyissimo-yolo/data/
third_party/tinyissimo-yolo/runs/
third_party/tinyissimo-yolo/checkpoints/
third_party/tinyissimo-yolo/*.pt
