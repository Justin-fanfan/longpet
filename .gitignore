# CMake / Qt Creator build output
/build*/
/cmake-build*/
CMakeUserPresets.json

# Generated binaries and runtime files
*.exe
*.dll
*.pdb
*.log
**/__pycache__/
*.py[cod]

# Python environments and tool caches
.venv/
.venv-*/
venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Local IDE state is machine-specific
.vscode/
.vs/
.qtcreator/

quicktest/

# Training products belong in an external ai-work workspace. These guards apply
# anywhere in the repository in case a script is pointed at the wrong output.
**/datasets/
**/runs/
**/cache/
**/checkpoints/
**/predictions/
**/teacher_models/
*.pt
*.pth
*.ckpt

# Raw datasets and captured media are not source assets.
*.mp4
*.mov
*.avi
*.mkv

# Local test/report output
/test-results/
/result.txt
