[asr]
# 华北 2（北京）专属域名需将 {WorkspaceId} 替换为百炼业务空间 ID。
provider=aliyun
api_base_url=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
api_key=replace-with-bailian-api-key
model=qwen-audio-3.0-asr-flash
language=zh

[llm]
# 百炼 Chat Completions 使用 OpenAI-compatible 协议。
provider=openai-compatible
api_base_url=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
api_key=replace-with-bailian-api-key
model=qwen-plus

[tts]
# qwen3-tts-flash 使用 DashScope multimodal-generation HTTP 接口。
provider=aliyun
api_base_url=https://dashscope.aliyuncs.com/api/v1
api_key=replace-with-bailian-api-key
model=qwen3-tts-flash
voice=Cherry

[voice]
system_prompt=你是 LongPet，一位耐心、温和、回答简短的陪伴助手。请使用中文回答，避免使用复杂术语。
request_timeout_ms=30000
# 轻量能量 VAD：阈值单位为 dBFS。环境噪声较大时可逐步调高到 -38 左右，
# 总是误判为静音时可逐步调低到 -48 左右。
vad_enabled=true
vad_threshold_db=-42.0
vad_silence_timeout_ms=900
recording_minimum_ms=600
vad_minimum_speech_ms=160
recording_maximum_ms=12000
# LLM 使用 OpenAI-compatible SSE；关闭后退回 V1 非流式回答。
llm_stream_enabled=true
# 完整句形成后立即加入顺序 TTS 队列。
sentence_tts_enabled=true
sentence_minimum_characters=6
sentence_maximum_characters=120
# 当前播放段之外最多预先保留的已合成语音段数，建议板端保持 1~2。
tts_prebuffer_segments=2
history_turns=4
# AI Provider 失败后，KWS 暂时使用离线策略；到期后重新允许在线尝试。
availability_retry_ms=30000

[tools]
# 仅开放 LongPet 内置白名单工具，不允许 shell、任意文件或任意 HTTP。
enabled=true
maximum_rounds=3

[kws]
# 依赖 third_party/longpet-kws 的源码+模型（见 deploy/配置说明.md 3.4.4），以及板端 numpy/onnxruntime/sounddevice 运行时。
# input_device 留空表示使用 PortAudio 默认输入设备，禁止永久写死设备序号。
# 采集设备解析顺序：LONGPET_KWS_ALSA_DEVICE → LONGPET_AI_CAPTURE_DEVICE(语音交互同款，服务已设) → 下行 alsa_device。
# 因此 alsa_device 仅在未设置上述环境变量时生效；推荐直接用服务里已有的 LONGPET_AI_CAPTURE_DEVICE，与语音交互共用同一麦克风。
enabled=true
python_program=/usr/bin/python3
bridge_script=/home/longpet/longpet-kws/longpet_kws_bridge.py
kws_root=/home/longpet/longpet-kws/upstream
model_path=/home/longpet/longpet-kws/upstream/assets/fsmn/fsmn_ctc.onnx
tokens_path=/home/longpet/longpet-kws/upstream/assets/fsmn/tokens.txt
capture_backend=sounddevice
input_device=
alsa_device=plughw:CARD=Device,DEV=0
input_sample_rate=48000
wake_threshold=0.15
hello_threshold=0.10
companion_threshold=0.05
emergency_threshold=0.05
vad_threshold_db=-60.0
vad_noise_ratio=2.5
command_timeout_ms=10000
pause_timeout_ms=1500
resume_cooldown_ms=1200
restart_delay_ms=2000

[offline]
enabled=true
companion_audio_directory=/home/longpet/offline-audio
