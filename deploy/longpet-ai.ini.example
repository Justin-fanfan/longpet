[ai]
# Base URL 应包含兼容接口的公共前缀；程序会在后面追加
# audio/transcriptions、chat/completions 和 audio/speech。
api_base_url=https://api.example.com/v1
api_key=replace-with-real-token

asr_model=whisper-1
llm_model=your-chat-model
tts_model=your-tts-model
tts_voice=alloy
language=zh

system_prompt=你是 LongPet，一位耐心、温和、回答简短的陪伴助手。请使用中文回答，避免使用复杂术语。
request_timeout_ms=30000
recording_maximum_ms=12000
history_turns=4
