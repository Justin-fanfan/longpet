[Unit]
Description=LongPet touch terminal
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple

User=longpet
Group=longpet
SupplementaryGroups=video input audio tty dialout

WorkingDirectory=/home/longpet
ExecStart=/home/longpet/LongPet

RuntimeDirectory=longpet
RuntimeDirectoryMode=0700

Environment="HOME=/home/longpet"
Environment="XDG_RUNTIME_DIR=/run/longpet"
Environment="LONGPET_DATABASE_PATH=/home/longpet/data/longpet.db"
Environment="LONGPET_AI_CONFIG=/etc/longpet/ai.ini"
Environment="LONGPET_WEATHER_CONFIG=/etc/longpet/longpet-weather.ini"

Environment="QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0:tty=/dev/tty1"
Environment="QT_QPA_GENERIC_PLUGINS=evdevtouch:/dev/input/event0"
Environment="QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS=/dev/input/event0"
Environment="QT_QPA_FB_HIDECURSOR=1"
Environment="QT_IM_MODULE=qtvirtualkeyboard"

# 暂时明确指向 USB 声卡，避免访问已经拆除的 ES8388。
# 当前 main 的 AudioVolumeAdapter 只识别 PCM 控件，因此可能提示
# USB 声卡没有 PCM；这不影响界面启动，下一轮再适配 Speaker 控件。
Environment="LONGPET_ALSA_MIXER_DEVICE=hw:CARD=Device"
# 语音交互与视频通话默认共用这组 USB 声卡设备。
Environment="LONGPET_AI_CAPTURE_DEVICE=plughw:CARD=Device,DEV=0"
Environment="LONGPET_AI_PLAYBACK_DEVICE=plughw:CARD=Device,DEV=0"

# Vision V2 已完成板端动态验收并作为正式服务启动。
# LONGPET_CAMERA_DEVICE 优先于旧 LONGPET_CALL_CAMERA_DEVICE；当前摄像头物理倒装。
Environment="LONGPET_VISION_ENABLED=1"
Environment="LONGPET_CAMERA_DEVICE=/dev/video0"
Environment="LONGPET_CAMERA_ROTATION=180"
Environment="LONGPET_VISION_DETECTOR=tinyissimo"
Environment="LONGPET_VISION_MODEL_PATH=/home/longpet/models/tinyissimo-person-128-longpet-v1.onnx"
Environment="LONGPET_VISION_TRACKING_ENABLED=1"
Environment="LONGPET_VISION_TRACKER_INTERVAL_MS=100"
Environment="LONGPET_VISION_DETECTOR_CORRECTION_MS=8000"
Environment="LONGPET_VISION_SEARCH_INTERVAL_MS=250"
Environment="LONGPET_VISION_LOST_INTERVAL_MS=250"
Environment="LONGPET_VISION_MONITOR_PORT=8789"
Environment="LONGPET_VISION_MONITOR_FPS=7"

# Family Remote Control V1：2K300 二号串口实际枚举为 ttyS2。
# 远控使用独立 WebSocket，MOVE 每 150 ms 刷新；LongPet 350 ms 租约
# 早于 Motion MCU 的 500 ms watchdog 停车。
Environment="LONGPET_MOTION_ENABLED=1"
Environment="LONGPET_MOTION_DEVICE=/dev/ttyS2"
Environment="LONGPET_MOTION_CONTROL_PORT=8790"
Environment="LONGPET_MOTION_REFRESH_MS=150"
Environment="LONGPET_MOTION_REMOTE_LEASE_MS=350"
Environment="LONGPET_MOTION_DEFAULT_SPEED=20"
Environment="LONGPET_MOTION_HEAD_STEP_US=20"
Environment="LONGPET_AUTO_HEAD_ENABLED=0"
Environment="LONGPET_AUTO_HEAD_MAX_TARGET_AGE_MS=500"
Environment="LONGPET_AUTO_HEAD_TARGET_EXPIRY_MS=500"

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
