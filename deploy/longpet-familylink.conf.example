#部署于/etc/systemd/system/longpet.service.d/familylink.conf
[Service]
# 局域网监听必须同时设置强随机 Token；不要把该文件中的占位值用于正式部署。
Environment="LONGPET_FAMILY_LINK_ADDRESS=0.0.0.0"
Environment="LONGPET_FAMILY_LINK_PORT=8787"
Environment="LONGPET_FAMILY_LINK_TOKEN=replace-with-a-random-token"
Environment="LONGPET_VISION_MONITOR_PORT=8789"
Environment="LONGPET_VISION_MONITOR_FPS=7"
Environment="LONGPET_AUTO_HEAD_ENABLED=0"
Environment="LONGPET_AUTO_HEAD_MAX_TARGET_AGE_MS=500"
Environment="LONGPET_AUTO_HEAD_TARGET_EXPIRY_MS=500"
Environment="LONGPET_MOTION_STATUS_POLL_MS=250"
Environment="LONGPET_FOLLOW_TARGET_STABLE_MS=600"
Environment="LONGPET_FOLLOW_MOTION_STATUS_MAX_AGE_MS=750"
Environment="LONGPET_FOLLOW_ALIGN_ENTER_US=220"
Environment="LONGPET_FOLLOW_ALIGN_EXIT_US=100"
Environment="LONGPET_FOLLOW_ALIGN_ENTER_DWELL_MS=400"
Environment="LONGPET_FOLLOW_ALIGN_EXIT_DWELL_MS=400"
Environment="LONGPET_FOLLOW_MIN_MOTION_MS=300"
Environment="LONGPET_FOLLOW_FAR_ENTER_HEIGHT=0.28"
Environment="LONGPET_FOLLOW_FAR_EXIT_HEIGHT=0.34"
Environment="LONGPET_FOLLOW_NEAR_ENTER_HEIGHT=0.78"
Environment="LONGPET_FOLLOW_NEAR_EXIT_HEIGHT=0.70"
Environment="LONGPET_FOLLOW_FORWARD_SPEED=12"
Environment="LONGPET_FOLLOW_ROTATE_SPEED=10"

# 可选的家属端显示信息。
# Environment="LONGPET_DEVICE_ID=longpet-ls-gd"
# Environment="LONGPET_DEVICE_NAME=LongPet LS-GD"
