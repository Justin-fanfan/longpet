# Install as /etc/systemd/system/longpet.service.d/vision.conf only after the
# detector benchmark is accepted. Vision remains disabled by default in the
# shipped service because it competes with KWS on the single-core 2K300.
[Service]
Environment="LONGPET_VISION_ENABLED=0"
Environment="LONGPET_VISION_DETECTOR=tinyissimo"
# Frozen Vision V1.2 domain-finetuned detector (SHA256 cb3defed...).
Environment="LONGPET_VISION_MODEL_PATH=/home/longpet/models/tinyissimo-person-128-longpet-v1.onnx"
Environment="LONGPET_VISION_CONFIDENCE_THRESHOLD=0.25"
Environment="LONGPET_VISION_NMS_THRESHOLD=0.45"
Environment="LONGPET_VISION_INFERENCE_THREADS=1"
Environment="LONGPET_VISION_INTERVAL_MS=300"
Environment="LONGPET_VISION_TRACKING_ENABLED=1"
Environment="LONGPET_VISION_TRACKER_INTERVAL_MS=100"
Environment="LONGPET_VISION_DETECTOR_CORRECTION_MS=8000"
Environment="LONGPET_VISION_SEARCH_INTERVAL_MS=250"
Environment="LONGPET_VISION_LOST_INTERVAL_MS=250"
Environment="LONGPET_VISION_FRESHNESS_MS=2500"
Environment="LONGPET_VISION_TRACKER_SCALE=0.5"
Environment="LONGPET_VISION_TRACKER_MAX_POINTS=60"
Environment="LONGPET_VISION_TRACKER_MIN_POINTS=6"
Environment="LONGPET_VISION_TRACKER_MIN_CONFIDENCE=0.15"
Environment="LONGPET_VISION_TRACKER_LOW_CONFIDENCE_FRAMES=3"
